APP_NAME=Laravel
APP_ENV=local
# Generated automatically on first container boot - never commit a real key.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL - `postgres` is the compose service name, reachable only inside the
# docker network.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# Redis backs cache, sessions and queues.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Origin allowed to call the API (the Vite dev server).
FRONTEND_URL=http://localhost:5173

# SCRUM-526 - Duree de validite d'un jeton d'API, en minutes (720 = 12 h).
# Passe ce delai le porteur doit se reconnecter : cela borne la fenetre
# pendant laquelle un jeton vole reste exploitable.
SANCTUM_TOKEN_EXPIRATION=720
SANCTUM_TOKEN_PREFIX=vitalis_

# MFA is enforced automatically in production; keep false for local development.
MFA_ENFORCE_SENSITIVE_ROLES=false
MFA_SENSITIVE_ROLES=administrateur,medecin
MFA_CODE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local development only. Production defaults to false.
ALLOW_PUBLIC_REGISTRATION=true

# Optional locally; production should use a dedicated random secret.
AUDIT_HMAC_KEY=

# Demo medical records/accounts for local development only.
ALLOW_DEMO_SEEDING=true
