# syntax=docker/dockerfile:1

# Production image for the Vue app: Vite builds static assets, nginx serves them.
# The development image (frontend/Dockerfile) runs `npm run dev`, which is a
# development server and must not be used to serve real traffic.

# ------------------------------------------------------------------ build
FROM node:22-alpine AS build

ENV npm_config_update_notifier=false \
    npm_config_fund=false \
    npm_config_audit=false

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# Baked into the bundle at build time: Vite inlines VITE_* variables, so this is
# a build argument, not a runtime one. It must not carry anything secret - the
# value ends up readable in the shipped JavaScript.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

# ------------------------------------------------------------------ serve
FROM nginx:1.29-alpine AS serve

# Pull fixed Alpine packages into the runtime image and prepare nginx paths for
# an unprivileged master process.
RUN apk upgrade --no-cache \
    && chown -R nginx:nginx /var/cache/nginx /var/run /etc/nginx/conf.d

COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html
COPY --chown=nginx:nginx docker/nginx.conf /etc/nginx/conf.d/default.conf

USER nginx

EXPOSE 8080

# nginx:alpine already runs a correct foreground command.
