# Template for the production stack (docker-compose.prod.yml).
#
#   cp .env.production.example .env.production
#   # fill in the secrets, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# NEVER commit the filled-in file. Values below are placeholders, not secrets.
# On a real target, prefer the platform's secret store (GitHub Actions secrets,
# a cloud secret manager, systemd credentials) over a file on disk.

COMPOSE_PROJECT_NAME=vitalis

# ------------------------------------------------------------- PUBLIC values
# Not sensitive. VITE_API_URL in particular is inlined into the JavaScript
# bundle at build time and is readable by anyone loading the site.
APP_URL=https://example.invalid
VITE_API_URL=https://example.invalid/api

# SCRUM-540 - Adresse publique du frontend. Sert aux origines autorisees par
# CORS et au lien de reinitialisation de mot de passe envoye par email.
# A defaut, APP_URL est utilise. A renseigner si le frontend est servi depuis
# une autre origine que l'API.
FRONTEND_URL=https://example.invalid
API_PORT=8080
WEB_PORT=8081

# Schema changes are applied only when this is explicitly set to true.
RUN_MIGRATIONS=false

# SCRUM-526 - Duree de vie d'un jeton d'API, en minutes. Passe ce delai, le
# porteur doit se reconnecter. Baisser la valeur reduit la fenetre pendant
# laquelle un jeton vole reste exploitable. Defaut applicatif : 720 (12 h).
SANCTUM_TOKEN_EXPIRATION=720
SANCTUM_TOKEN_PREFIX=vitalis_

# Second facteur obligatoire pour les comptes les plus sensibles.
MFA_ENFORCE_SENSITIVE_ROLES=true
MFA_SENSITIVE_ROLES=administrateur,medecin
MFA_CODE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5

# Cookies de session durcis (utiles si Sanctum utilise le mode stateful).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true

# ---------------------------------------------------------- SENSITIVE values
# Every entry below is a secret. Generate them per environment; never reuse the
# development values and never reuse one environment's values in another.

# php artisan key:generate --show
# Changing it makes existing sessions and encrypted column values unreadable.
APP_KEY=

# PostgreSQL credentials. DB_DATABASE and DB_USERNAME are not secret on their
# own, but they are grouped here because they must match the database that was
# provisioned with DB_PASSWORD.
DB_DATABASE=vitalis
DB_USERNAME=vitalis
DB_PASSWORD=

# Redis requires authentication in production; the container refuses to start
# without it.
REDIS_PASSWORD=


# ------------------------------------------------------------- EMAIL / MFA
# MFA is mandatory for sensitive roles in production. Configure a real mail
# transport: the application refuses to issue MFA codes through the log/array
# mailers in production.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_FROM_NAME=VITALIS

# Patient/staff accounts are provisioned by an administrator.
ALLOW_PUBLIC_REGISTRATION=false

# Dedicated random key used to sign audit records (do not reuse DB/Redis secrets).
AUDIT_HMAC_KEY=

# Never seed demo patients/accounts into production.
ALLOW_DEMO_SEEDING=false
